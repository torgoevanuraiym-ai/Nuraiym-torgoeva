# Admin password required to access the coordinator panel (set in Secrets / environment)
ADMIN_PASSWORD=

# Secret key for signing admin session cookies (auto-generated if omitted)
SESSION_SECRET=

# Directory for persistent JSON storage (default: data)
DATA_DIR=data

# Auto-delete volunteer applications older than this many days (0 = disable)
RETENTION_DAYS=365

# Base64-encoded Google Service Account JSON key for Google Sheets backup mirror (optional)
GOOGLE_SERVICE_ACCOUNT_B64=

# Target Google Spreadsheet ID for backup mirror (optional)
GOOGLE_SHEET_ID=
